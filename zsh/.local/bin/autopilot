#!/usr/bin/env zsh
# ---
# label: TOOL
# role: starts an unattended autopilot run (the autopilot skill) on one repo as a background
#   Claude Code session that shows up in `claude agents`, and keeps the Mac awake for it.
# invariants:
#   - Reads the repo's contract at ~/.claude/autopilot/<repo>.md (bam-claude); its frontmatter
#     gives the path, effort, bg_isolation and extra allow rules.
#   - The session gets denyInsteadOfPrompting through --settings, scoped to this run only, so
#     it never waits on a prompt; anything that would prompt is refused and logged.
#   - The extra allow rules also live only in this run's --settings, never in settings.json.
#   - Contract allow rules must pass rule_ok, an allowlist (gh pr|issue subcommands; Edit
#     of a plain path inside the repo, with no .git, .mcp.json or nested .claude component),
#     or the run doesn't start.
#   - Each Edit(.../**) rule gets deny rules for the .git, .claude/ and .mcp.json inside its
#     subtree. A worktree under .claude/worktrees has its own .claude/settings.json and
#     hooks, and those run unsandboxed. Deny beats allow.
#   - The run's --settings carry a PreToolUse hook, `autopilot --hook-gh <repo>`
#     (gh_guard). gh is sandbox-excluded, so a gh command the allow rules let through runs
#     unsandboxed with the owner's token. The guard keeps gh to this repo, to a few
#     subcommands, and to body files the sandbox could read anyway. It fails closed:
#     anything but an explicit pass exits 2.
#   - All git here runs from the owner's unsandboxed terminal, so it goes through sgit (no
#     global or system config, fsmonitor and hooks off) and only after git_config_ok has
#     checked the repo's config against an allowlist. Other repos' .git dirs are
#     sandbox-writable from sessions rooted elsewhere; on 2026-11-24 a dotfiles session could
#     open MusicPortfolio/.git/config and .git/hooks for writing.
#   - --tidy removes only trees autopilot registered (notes start "autopilot") whose PR is
#     merged or closed, and only when the tree is clean and its HEAD is the PR's last head.
#     The registry is sandbox-writable, so the tree must also be a real worktree of the
#     repo directly under .claude/worktrees, on a worktree-* branch.
#   - --tidy also takes autopilot rows another session already marked merged or abandoned
#     while their tree is still on disk (the coordinator marks a row at merge time and the
#     sandbox keeps it from removing the tree). GitHub's PR state still decides; an existing
#     merged_at/abandoned_at is kept, otherwise the stamp is GitHub's merge or close time.
#     Rows whose notes don't start "autopilot" are never taken, whatever their status.
#   - --tidy runs git in trees a sandboxed session used, so it first checks the tree's git
#     links (.git file, gitdir, commondir, no config.worktree). A planted commondir pointing
#     at a config with core.fsmonitor ran its command under a plain `git -C <tree> status`
#     (tested). Its status ignores submodules, because a gitlink in a planted index would
#     make status recurse into a nested repo whose config the session wrote.
#     It runs from the owner's terminal: a sandboxed session can't write .git/worktrees.
# gotchas:
#   - The contract parser handles only this flat shape: `key: value` lines and an `allow:`
#     list of `  - "rule"` lines. Keep the frontmatter that simple.
#   - caffeinate keeps the Mac awake on its own, but not with the lid closed on battery.
#   - Never name a variable `path` here: zsh ties it to $PATH (first dry run lost awk and jq).
#   - Starting the same repo twice runs two sessions on it. Check `claude agents` first.
#   - git_config_ok refuses any repo config key outside its allowlist. A new kind of key in
#     a contract repo (a submodule, lfs, a VS Code branch key) stops the run with the key's
#     name; widen cfg_ok_pat deliberately.
#   - The hook runs on every Bash call in the run, so keep its fast path (no "gh" in the
#     command) cheap.
# last-touched: 2026-11-24
# ---

self=${0:A}

# ---- git a sandboxed session can't steer -----------------------------------------------
# -c overrides can't neutralize every exec-capable key (a filter driver plus
# .git/info/attributes, for one), so git_config_ok's allowlist is the real defence and sgit
# is belt and braces. Data keys only: nothing on the list names a command, filter or hook.
cfg_ok_pat='(core.(repositoryformatversion|filemode|bare|logallrefupdates|ignorecase|precomposeunicode|symlinks|hookspath)|extensions.(worktreeconfig|objectformat|refstorage)|remote.*.(url|pushurl|fetch|gh-resolved|prune|tagopt)|branch.*.(remote|merge|rebase|pushremote|description|vscode-merge-base)|lfs.repositoryformatversion|user.(name|email)|pull.(rebase|ff)|push.(default|autosetupremote)|fetch.prune|init.defaultbranch)'

sgit() {
  GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1 GIT_TERMINAL_PROMPT=0 \
    command git --no-pager -c core.fsmonitor=false -c core.hooksPath=/dev/null "$@"
}

# find_git <dir>: reply=(top common-gitdir [per-tree-gitdir]) for the checkout holding dir.
# Reads the .git links itself, so no git runs before git_config_ok.
find_git() {
  local d=${1:A} link c
  reply=()
  while :; do
    if [[ -L $d/.git ]]; then return 1
    elif [[ -d $d/.git ]]; then reply=($d $d/.git); return 0
    elif [[ -f $d/.git ]]; then
      link=$(<$d/.git); link=${link#gitdir: }
      [[ $link == /* ]] || link=$d/$link
      [[ -d $link && -f $link/commondir ]] || return 1
      c=$(<$link/commondir); [[ $c == /* ]] || c=$link/$c
      reply=($d ${c:A} ${link:A}); return 0
    fi
    [[ $d == / ]] && return 1
    d=${d:h}
  done
}

# git_config_ok <common-gitdir> [per-tree-gitdir]: 0 when every key in its config files is
# on cfg_ok_pat. Parses with `git config --file --no-includes -z` from /, which runs nothing.
# Two keys are data only for some values, so their values are checked too:
#   - core.hookspath: only in the common config, and only pointing at its own hooks dir
#     (MusicPortfolio sets it that way). Anywhere else it picks the hooks git runs.
#   - remote.*.url|pushurl: only https://github.com/OWNER/REPO or git@github.com:OWNER/REPO.
#     ext::, file paths and the like make a push or fetch run or write something else.
git_config_ok() {
  local f out e k v
  local -a bad files=($1/config $1/config.worktree)
  local url_re='^(https://github\.com/|git@github\.com:)[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$'
  [[ -n ${2:-} ]] && files+=($2/config.worktree)
  for f in $files; do
    [[ -e $f || -L $f ]] || continue
    [[ -f $f && ! -L $f ]] || { print -u2 -r -- "autopilot: $f isn't a plain file"; return 1 }
    out=$(cd / && GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1 command git config --file "$f" --no-includes -z --list) \
      || { print -u2 -r -- "autopilot: can't parse $f"; return 1 }
    for e in ${(ps:\0:)out}; do
      k=${e%%$'\n'*}
      [[ $e == *$'\n'* ]] && v=${e#*$'\n'} || v=''
      if [[ $k != ${~cfg_ok_pat} ]]; then bad+=("$k ($f)")
      elif [[ $k == core.hookspath ]]; then
        [[ $f == $1/config && $v == /* && ${v:A} == ${1:A}/hooks ]] || bad+=("$k=$v ($f)")
      elif [[ $k == remote.*.(url|pushurl) ]]; then
        [[ $v =~ $url_re ]] || bad+=("$k=$v ($f)")
      fi
    done
  done
  (( $#bad )) || return 0
  print -u2 -r -- "autopilot: git config key(s) outside the allowlist: ${(j:, :)bad}"
  return 1
}

# ---- --hook-gh: PreToolUse guard for gh in an autopilot run ----------------------------
# gh runs unsandboxed (sandbox.excludedCommands), so a gh command the run's allow rules let
# through can reach other repos and read files the sandbox denies. Rules:
#   - gh runs only as one plain command: first word gh, and no other command, separator,
#     redirect, substitution or variable anywhere in it. A gh word elsewhere in a command
#     (after a separator, in $(...), after env/xargs/time) is refused outright. gh only
#     works alone anyway, since a companion command sandboxes the call.
#   - Subcommands: pr create|edit|comment|checks|view|list|diff|ready, issue edit|view|list,
#     run view|list, release view|list, auth status.
#   - No --repo/-R, no URL or OWNER/REPO#N argument outside a --body/--title value, and
#     short flags one at a time (-b x, not -bx or -dR).
#   - --body-file/-F: a plain path (no quotes, globs or variables) to a regular file with
#     one link, inside the repo or the sandbox temp dirs (/tmp/claude, /tmp/claude-<uid>).
#     Never "-" (stdin). A repo holding sandbox-read-denied files would need its own rule.
# Claude Code reads any exit but 2 as "go ahead", so the guard runs in a subshell and only
# an explicit pass exits 0.
has_expansion() {  # <raw word> [notilde]: 0 when the shell would expand something in it
  local w=$1 c q='' i tilde='~'
  [[ ${2:-} == notilde ]] && tilde=''
  for (( i = 1; i <= $#w; i++ )); do
    c=$w[i]
    if [[ $q == "'" ]]; then [[ $c == "'" ]] && q=''; continue; fi
    if [[ $c == '\' ]]; then (( i++ )); continue; fi
    if [[ $q == '"' ]]; then
      [[ $c == '"' ]] && { q=''; continue }
      [[ $c == '$' || $c == '`' ]] && return 0
      continue
    fi
    case $c in
      "'") q="'" ;;
      '"') q='"' ;;
      '$'|'`'|'*'|'?'|'[') return 0 ;;
      '~') [[ -n $tilde ]] && return 0 ;;
      '<'|'>') [[ ${w[i+1]-} == '(' ]] && return 0 ;;
    esac
  done
  return 1
}

gh_guard() {
  emulate -L zsh
  setopt extended_glob
  zmodload -F zsh/stat b:zstat || return 1
  local root=${1:?} input cmd cwd
  # Pipes, not <<<: a here-string needs a temp file, and the hook may run without $TMPDIR.
  input=$(cat) || return 1
  cmd=$(print -r -- "$input" | jq -er '.tool_input.command | strings') || return 1
  local -a raw val roots
  raw=("${(@z)cmd}")
  val=("${(@Q)raw}")
  # Fast path on the unquoted words too: g''h, g\h and "g"h hold no "gh" in the raw text.
  # Anything with $ (ANSI $'...' quoting, variables) or a glob character (g? could match a
  # file named gh) takes the full check.
  [[ $cmd == *gh* || ${(j: :)val} == *gh* || $cmd == *[\$\*\?\[]* ]] || return 0
  cwd=$(print -r -- "$input" | jq -r '.cwd // empty') || return 1
  # Plain variables: ${${:-/tmp/claude-$UID}:A} in an array garbles the "-" (zsh quirk).
  local tmp_uid=/tmp/claude-$UID tmp_shared=/tmp/claude
  roots=(${root:A} ${tmp_uid:A} ${tmp_shared:A})
  local ghword='(^|[^A-Za-z0-9_.-])gh([^A-Za-z0-9_.-]|$)'
  local i
  no() { print -u2 -r -- "autopilot guard: $*"; return 1 }

  if [[ $raw[1] != gh ]]; then
    # gh in command position anywhere: a segment's first word (after assignments), or any
    # word of a segment led by a precommand. A gh word that's only an argument (a commit
    # message, a grep pattern) is fine, except inside a substitution, which can't be told
    # apart from text cheaply: there the message says to use a file instead.
    # Any operator-only token (separators, pipes, redirects, parens, braces) resets to command
    # position, as do the reserved words that can lead a command. (z) turns newlines into ";".
    local -a seps=(then do else elif if while until case esac in fi done function coproc repeat select foreach)
    local -a pre=(env xargs time nohup command exec builtin noglob nocorrect nice timeout sudo caffeinate coproc)
    local head=1 inpre=0
    for (( i = 1; i <= $#raw; i++ )); do
      if [[ $raw[i] == [\;\&\|\(\)\<\>\{\}\!]## || $raw[i] == <->[\<\>]* ]] || (( ${seps[(Ie)$raw[i]]} )); then
        head=1 inpre=0; continue
      fi
      if has_expansion "$raw[i]" && [[ $raw[i] =~ $ghword ]]; then
        no "no gh inside a substitution or variable; if gh is only text here, put the text in a file (git commit -F <file>)"; return 1
      fi
      if (( head )); then
        [[ $raw[i] =~ '^[A-Za-z_][A-Za-z0-9_]*=' ]] && continue
        head=0
        # A command word that the shell expands ($X, $'..', $(..), or a glob like g? that
        # could match a file named gh) could be gh in disguise. A leading ~ is fine.
        has_expansion "$raw[i]" notilde && { no "the command word can't be a variable, substitution or glob here: ${raw[i]}"; return 1 }
        (( ${pre[(Ie)$val[i]]} )) && inpre=1
      elif (( ! inpre )); then
        continue
      fi
      [[ $val[i] == gh || $val[i] == */gh ]] && { no "run gh as its own plain command: first word gh, nothing else on the line"; return 1 }
    done
    return 0
  fi

  for (( i = 2; i <= $#raw; i++ )); do
    has_expansion "$raw[i]" && { no "gh: no variables, globs, ~ or substitutions outside single quotes: ${raw[i]}"; return 1 }
    [[ $raw[i] == [\;\&\|\(\)\{\}\<\>]* || $raw[i] == <->[\<\>]* ]] && { no "gh runs alone: no separators, pipes or redirects (${raw[i]})"; return 1 }
  done
  case "${val[2]-} ${val[3]-}" in
    ('pr '(create|edit|comment|checks|view|list|diff|ready)|'issue '(edit|view|list)|'run '(view|list)|'release '(view|list)|'auth status') ;;
    (*) no "gh ${val[2]-} ${val[3]-} isn't allowed in an autopilot run"; return 1 ;;
  esac

  body_file_ok() {  # <value> <raw>
    local v=$1 r=$2 p real rt
    local -a nl
    [[ -n $v && $v != - ]] || { no "--body-file needs a file, not stdin"; return 1 }
    [[ $r =~ '^[A-Za-z0-9_./+@%,:=-]+$' ]] || { no "--body-file: write the path plainly (no quotes, ~, globs or variables)"; return 1 }
    p=$v
    [[ $p == /* ]] || p=$cwd/$p
    real=${p:A}
    [[ -f $real ]] || { no "--body-file $v: not a regular file"; return 1 }
    zstat -A nl +nlink -- $real || return 1
    (( nl[1] == 1 )) || { no "--body-file $v: has ${nl[1]} hard links"; return 1 }
    for rt in $roots; do [[ $real == $rt/* ]] && return 0; done
    no "--body-file $v resolves to $real, outside the repo and the sandbox temp dirs"
  }
  target_ok() {  # <value>: refuse a selector that names another repo
    [[ $1 == *://* || $1 == (#i)*github.com* || $1 == [^/]##/[^/]##\#* ]] \
      && { no "gh: no URL or OWNER/REPO targets ($1); use the number in this repo"; return 1 }
    return 0
  }

  local v opts=1
  for (( i = 4; i <= $#val; i++ )); do
    v=$val[i]
    if (( ! opts )); then target_ok "$v" || return 1; continue; fi
    case $v in
      (--) opts=0 ;;
      (--repo|--repo=*|-R*) no "gh: no --repo/-R; an autopilot run stays on its own repo"; return 1 ;;
      (--body-file|-F) (( i++ )); body_file_ok "${val[i]-}" "${raw[i]-}" || return 1 ;;
      (--body-file=*) body_file_ok "${v#--body-file=}" "${raw[i]#--body-file=}" || return 1 ;;
      (--body|-b|--title|-t) (( i++ )) ;;
      (--*) ;;
      (-?) ;;
      (-?*) no "gh: give short flags one at a time with a separate value ($v)"; return 1 ;;
      (*) target_ok "$v" || return 1 ;;
    esac
  done
  return 0
}

if [[ ${1:-} == --hook-gh ]]; then
  PATH=/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin
  ( gh_guard "${2:-}" ) && exit 0
  exit 2
fi

usage() {
  cat <<'EOF'
autopilot: start an unattended development run on a repo (see the autopilot skill)

  autopilot <repo> [--item REF] [--hours N] [--dry-run]
  autopilot --tidy <repo> [--dry-run]
  autopilot --list

  <repo>      a contract name in ~/.claude/autopilot/ (play, music-platform, ...)
  --item REF  work only this one item (an issue number like 991, or a backlog line),
              still under the contract's eligibility and off-limits rules
  --hours N   keep the Mac awake for N hours (default 10)
  --tidy      instead of starting a run, remove the worktrees and local branches of this
              repo's autopilot PRs that are merged or closed, and mark them in the registry
  --dry-run   print the claude command and settings instead of starting (with --tidy:
              print what it would remove)

The run's devlog: ~/.claude/devlogs/autopilot-<repo>-devlog.md (essay server: /devlogs).
Watch it in agent view: prefix + A, or `claude agents`.
EOF
}

die() { print -u2 -r -- "autopilot: $*"; exit 1 }

dir=$HOME/.claude/autopilot
repo='' hours=10 dry=0 item='' tidy=0
while (( $# )); do
  case $1 in
    --hours) (( $# >= 2 )) || die "--hours needs a value"; hours=$2; shift 2 ;;
    --item) (( $# >= 2 )) || die "--item needs a value"; item=$2; shift 2 ;;
    --dry-run) dry=1; shift ;;
    --tidy) tidy=1; shift ;;
    --list) for f in $dir/*.md(N); do print -r -- ${f:t:r}; done; exit 0 ;;
    -h|--help) usage; exit 0 ;;
    -*) die "unknown option $1 (try -h)" ;;
    *) [[ -z $repo ]] || die "one repo at a time"; repo=$1; shift ;;
  esac
done
[[ -n $repo ]] || { usage >&2; exit 2; }
# The name lands in paths (the contract, the devlog rule), so it's a bare name only.
name_re='^[A-Za-z0-9][A-Za-z0-9_-]*$'
[[ $repo =~ $name_re ]] || die "bad repo name: $repo (letters, digits, - and _ only)"
contract=$dir/$repo.md
[[ -r $contract ]] || die "no contract at $contract (autopilot --list)"
[[ $hours == <-> ]] || die "--hours takes a whole number"

# Frontmatter: the lines between the first two '---'.
fm=$(awk '/^---$/ { n++; next } n == 1' "$contract")
field() { print -r -- "$fm" | awk -v k="$1" -F': *' '$1 == k { sub(/^[^:]*: */, ""); print; exit }' }
# Not `path`: in zsh that name is tied to $PATH, and assigning it breaks every command.
repo_dir=$(field path); repo_dir=${repo_dir/#\~/$HOME}
effort=$(field effort)
isolation=$(field bg_isolation)
typeset -a allow
allow=("${(@f)$(print -r -- "$fm" | awk '/^allow:/ { a = 1; next } a && /^  - / { sub(/^  - /, ""); gsub(/^"|"$/, ""); print; next } a { a = 0 }')}")
allow=(${allow:#})

[[ -d $repo_dir ]] || die "contract path doesn't exist: $repo_dir"
[[ ${repo_dir:A} == ${HOME:A}/Development/* ]] || die "contract path must be under ~/Development: $repo_dir"

# The contract's allow rules widen this run's permissions, so each must pass the owner's
# allow-rule hygiene (memory feedback_allow_rule_hygiene) or the run doesn't start:
#   - An allowlist, not a denylist: allow rules don't take a command out of the sandbox, so a
#     Bash rule only matters for sandbox-excluded commands (gh, git push, git config...), and
#     contracts need exactly `gh pr|issue <listed subcommand> [*]`. No merge, api, extension
#     or alias.
#   - Edit(~/...): a literal path inside the repo, optionally ending in "/**", and no other
#     glob character, so the checks below see the real path. No "." or ".." segment, no .git
#     or .mcp.json component, and no .claude component except a leading .claude/worktrees
#     (project settings, hooks and skills would widen later sessions, and every worktree has
#     its own .claude/). Every component before the last must already exist, and none may
#     be a symlink. Whether a symlink made mid-run is followed is Claude Code's permission
#     check at use time, not this one.
#   - A "/**" rule also gets deny rules (below) for the same names anywhere inside its
#     subtree, since one glob can't be checked component by component here.
#   - Nothing else. Widen this check deliberately if a contract ever needs more.
rule_ok() {
  local r=$1 inner lit rel comp p i
  local -a comps
  local gh_re='^gh (pr (create|edit|comment|checks|view|list|diff|ready)|issue (edit|view|list))( \*)?$'
  local path_re='^~(/[A-Za-z0-9._-]+)+(/\*\*)?$'
  case $r in
    'Bash('*')')
      inner=${${r#Bash\(}%\)}
      [[ $inner =~ $gh_re ]] ;;
    'Edit('*')')
      inner=${${r#Edit\(}%\)}
      [[ $inner =~ $path_re && $inner/ != */./* && $inner/ != */../* ]] || return 1
      lit=${${inner%/\*\*}/#\~/$HOME}
      [[ $lit == $repo_dir/* ]] || return 1
      rel=${lit#$repo_dir/}
      comps=(${(s:/:)rel}) p=$repo_dir
      # Lowercased: macOS volumes are case-insensitive, so .CLAUDE is .claude on disk. The one
      # exception must be spelled exactly .claude/worktrees.
      for (( i = 1; i <= $#comps; i++ )); do
        case ${comps[i]:l} in
          (.git|.mcp.json) return 1 ;;
          (.claude) (( i == 1 )) && [[ $comps[1] == .claude && ${comps[2]-} == worktrees ]] || return 1 ;;
        esac
      done
      for comp in $comps; do
        p=$p/$comp
        [[ -L $p ]] && return 1
        [[ -e $p || $p == $lit ]] || return 1
      done
      return 0 ;;
    *) return 1 ;;
  esac
}
for r in $allow; do
  rule_ok "$r" || die "contract allow rule refused: $r (allowed: gh pr|issue <subcommand> [*], or Edit of a plain path inside $repo_dir; see rule_ok)"
done
# Inside a "/**" subtree, deny what rule_ok refuses at its top: .git, .claude/ and .mcp.json
# at any depth. Deny beats allow in Claude Code, and the ~/ form matches the allow rule's.
# Each name also gets a [cC]-class spelling, since macOS volumes are case-insensitive and
# whether Claude Code's matcher folds case is unverified. A class the matcher didn't support
# would match nothing, so the plain spelling stays too.
anycase() { local s=$1 o='' c; for c in ${(s::)s}; do [[ $c == [a-z] ]] && o+="[$c${(U)c}]" || o+=$c; done; print -r -- $o }
typeset -a deny
for r in $allow; do
  [[ $r == 'Edit('*'/**)' ]] || continue
  p=${${r#Edit\(}%/\*\*\)}
  for n in .git .claude .mcp.json; do
    for s in $n $(anycase $n); do
      case $n in
        (.git) deny+=("Edit($p/**/$s)" "Edit($p/**/$s/**)") ;;
        (.claude) deny+=("Edit($p/**/$s/**)") ;;
        (.mcp.json) deny+=("Edit($p/**/$s)") ;;
      esac
    done
  done
done
# The devlog sits outside the repo, so the run needs an explicit write rule for it. The
# launcher adds it itself; the contract can't.
allow+=("Edit(~/.claude/devlogs/autopilot-$repo-devlog.md)")

# Claude Code runs git in the repo itself, outside the sandbox, and so does --tidy. Refuse
# a repo whose config holds anything but data keys (git_config_ok).
find_git "$repo_dir" || die "contract path isn't inside a git checkout: $repo_dir"
repo_git=("${reply[@]}")
git_config_ok "${repo_git[2]}" "${repo_git[3]-}" \
  || die "refusing $repo_dir: its git config has keys outside the allowlist; check them by hand (cfg_ok_pat)"

# Phase 1 of the skill dates the owner's contract changes by their commit. Compared by blob
# (hash-object --no-filters against HEAD), so no status, filter or fsmonitor runs.
if find_git "${contract:A:h}"; then
  contract_git=("${reply[@]}")
  if git_config_ok "${contract_git[2]}" "${contract_git[3]-}" 2>/dev/null; then
    crel=${${contract:A}#${contract_git[1]}/}
    cblob=$(sgit -C "${contract_git[1]}" rev-parse -q --verify "HEAD:$crel" 2>/dev/null)
    [[ -n $cblob && $cblob == $(sgit -C "${contract_git[1]}" hash-object --no-filters -- "$crel" 2>/dev/null) ]] \
      || print -u2 -r -- "autopilot: note: $repo.md has uncommitted changes. The run reads them, but can't date them as your answers until they're committed."
  else
    print -u2 -r -- "autopilot: note: skipped the uncommitted-contract check; ${contract_git[2]}/config has keys outside the allowlist."
  fi
fi

# --tidy: retire the trees of autopilot PRs that merged or closed. Registry-driven, so it
# never touches a .claude/worktrees tree some other session made.
tidy_trees() {
  local reg=$HOME/.claude/worktree-registry.json rname=${$(field repo):-$repo}
  [[ -r $reg ]] || die "no registry at $reg"
  (( $+commands[gh] )) || die "--tidy needs gh"
  cd "$repo_dir" || die "can't cd to $repo_dir"
  local -a rows
  rows=("${(@f)$(jq -r --arg r "$rname" '.worktrees[]
      | select(.repo == $r and ((.notes // "") | startswith("autopilot"))
          and (.status == "active" or .status == "merged" or .status == "abandoned"))
      | [.worktree_path, .branch, .status, (.port_offset // "" | tostring)] | @tsv' "$reg")}")
  rows=(${rows:#})
  (( $#rows )) || { print -r -- "autopilot: no autopilot worktrees registered for $rname"; return 0 }

  # Sandboxed sessions can write the registry, so an entry only names a candidate: the tree
  # must also sit directly under this repo's .claude/worktrees and, if it exists, be one of
  # the repo's own worktrees on a Claude Code-named branch.
  local root=${repo_dir:A}/.claude/worktrees
  # The trees are found from the main checkout's side, so the contract path must be one
  # (its config already passed git_config_ok at the top).
  [[ ${repo_git[1]} == ${repo_dir:A} && ${repo_git[2]} == ${repo_dir:A}/.git ]] \
    || die "--tidy needs the contract path to be a main checkout: $repo_dir"
  local -a known
  known=(${${(M)${(f)"$(sgit -C "$repo_dir" worktree list --porcelain)"}:#worktree *}#worktree })
  known=(${known:A})

  # The session that used a tree could write its git metadata (.git/worktrees/<id>/, and
  # the tree's .git file), e.g. point commondir at a config with core.fsmonitor set. So git
  # never runs in a tree until its links are the standard ones, and then only as sgit,
  # against the gitdir found from the main repo's side.
  local -a G
  local f gd link

  local row wt br port rst pr num state head when lb st stamp note out what removed=0
  for row in $rows; do
    # Tab is IFS whitespace, so an empty field collapses: keep the one that can be empty
    # (port) last.
    IFS=$'\t' read -r wt br rst port <<< "$row"
    # A row already marked merged or abandoned is only work if its tree is still on disk.
    [[ $rst != active && ! -e $wt ]] && continue
    [[ ${wt:A:h} == $root ]] || { print -r -- "skip    $wt: not under $root"; continue }
    if [[ -d $wt ]] && (( ! ${known[(Ie)${wt:A}]} )); then
      print -r -- "skip    ${wt:t}: not a worktree of $repo_dir"; continue
    fi
    if [[ -d $wt ]]; then
      gd=''
      for f in ${repo_dir:A}/.git/worktrees/*/gitdir(N); do
        [[ ${$(<$f):A} == ${wt:A}/.git ]] && { gd=${f:h:A}; break }
      done
      [[ -n $gd ]] || { print -r -- "skip    ${wt:t}: no git metadata for it in $repo_dir/.git/worktrees"; continue }
      link=''
      [[ -f $wt/.git ]] && link=$(<$wt/.git) && link=${link#gitdir: }
      [[ -n $link && ${link:A} == $gd ]] \
        || { print -r -- "skip    ${wt:t}: its .git file doesn't point at $gd"; continue }
      [[ $(<$gd/commondir) == ../.. && ! -e $gd/config.worktree ]] \
        || { print -r -- "skip    ${wt:t}: nonstandard git metadata in $gd; check it by hand"; continue }
      G=(sgit --git-dir="$gd" --work-tree="$wt")
    fi
    if ! pr=$(gh pr list --head "$br" --state all --limit 1 --json number,state,headRefOid,mergedAt,closedAt); then
      print -r -- "skip    ${wt:t}: gh couldn't look up $br"; continue
    fi
    num=$(jq -r '.[0].number // empty' <<< "$pr")
    state=$(jq -r '.[0].state // empty' <<< "$pr")
    head=$(jq -r '.[0].headRefOid // empty' <<< "$pr")
    when=$(jq -r '.[0].mergedAt // .[0].closedAt // empty' <<< "$pr")
    [[ -n $num ]] || { print -r -- "keep    ${wt:t}: no PR for $br"; continue }
    [[ $state == OPEN ]] && { print -r -- "keep    ${wt:t}: PR #$num is open"; continue }
    [[ -z $port ]] || { print -r -- "skip    ${wt:t}: has a dev stack (port offset $port); use worktree-orchestrator cleanup"; continue }

    lb=''
    if [[ -d $wt ]]; then
      # --ignore-submodules=all: a gitlink in a planted index would otherwise make status
      # recurse into a nested repo with a config the session wrote. `worktree remove`
      # refuses trees with submodules anyway.
      [[ -z $($G status --porcelain --ignore-submodules=all) ]] || { print -r -- "skip    ${wt:t}: uncommitted changes"; continue }
      [[ $($G rev-parse HEAD) == $head ]] || { print -r -- "skip    ${wt:t}: HEAD isn't PR #$num's last head; unpushed work?"; continue }
      lb=$($G branch --show-current)
      [[ $lb == worktree-* ]] || { print -r -- "skip    ${wt:t}: branch '$lb' isn't a Claude Code worktree branch"; continue }
    fi
    if [[ -d $wt ]]; then
      what="tree and local branch removed by autopilot --tidy"
      (( dry )) && { print -r -- "would remove ${wt:t}${lb:+ and branch $lb} (PR #$num ${state:l})"; continue }
      sgit -C "$repo_dir" worktree remove "$wt" || { print -r -- "skip    ${wt:t}: git worktree remove failed"; continue }
      [[ -n $lb ]] && sgit -C "$repo_dir" branch -D "$lb" >/dev/null
    else
      what="tree was already gone; entry closed by autopilot --tidy"
      (( dry )) && { print -r -- "would close ${wt:t}'s entry, tree already gone (PR #$num ${state:l})"; continue }
    fi

    if [[ $state == MERGED ]]; then
      st=merged stamp=merged_at note=" | Merged as PR #$num; $what."
    else
      st=abandoned stamp=abandoned_at note=" | PR #$num closed unmerged; $what."
    fi
    # Write in place (not mv) so the file keeps its inode and permissions.
    out=$(jq --arg w "$wt" --arg old "$rst" --arg s "$st" --arg k "$stamp" \
        --arg t "${when:-$(date -u +%Y-%m-%dT%H:%M:%SZ)}" --arg n "$note" '
      .worktrees |= map(if .worktree_path == $w and .status == $old
        then .status = $s | .[$k] //= $t | .port_offset = null | .notes += $n else . end)' "$reg") \
      && print -r -- "$out" > "$reg" || print -r -- "warn    ${wt:t}: removed, but the registry update failed"
    print -r -- "done    ${wt:t}: PR #$num ${state:l}, $what"
    (( removed++ ))
  done
  (( dry )) || print -r -- "autopilot: tidied $removed tree(s) for $rname"
}
if (( tidy )); then
  tidy_trees; exit $?
fi

json_list() { if (( $# )); then print -rl -- "$@" | jq -R . | jq -s .; else print -r -- '[]'; fi }
hook_cmd="${(q)self} --hook-gh ${(q)${repo_dir:A}}"
settings=$(jq -n --argjson allow "$(json_list $allow)" --argjson deny "$(json_list $deny)" \
    --arg hook "$hook_cmd" --arg iso "$isolation" '
  { permissions: { denyInsteadOfPrompting: true, allow: $allow, deny: $deny },
    hooks: { PreToolUse: [ { matcher: "Bash", hooks: [ { type: "command", command: $hook } ] } ] },
    autoContinueAtUsageLimit: true }
  + (if $iso != "" then { worktree: { bgIsolation: $iso } } else {} end)')

name="AUTOPILOT-${(U)repo}-$(date +%m%d)${item:+-${item//[^A-Za-z0-9]/}}"
prompt="Run the autopilot skill for $repo. Contract: ~/.claude/autopilot/$repo.md. This is an unattended run: nobody will answer prompts or questions until it ends, so record every question and blocker in the devlog."
if [[ -n $item ]]; then
  [[ $item == <-> ]] && ref="issue #$item" || ref="the backlog item \"$item\""
  prompt+=" This run is limited to one item, $ref: skip phase 2 (tending other work), the contract's extra phases such as Triage, and every other item. If it isn't eligible under the contract, build nothing and log why."
fi

claude_bin=${commands[claude]:-/opt/homebrew/bin/claude}
typeset -a cmd
cmd=("$claude_bin" --bg -n "$name" --settings "$settings")
[[ -n $effort ]] && cmd+=(--effort "$effort")
cmd+=("$prompt")

if (( dry )); then
  print -r -- "cd ${(q-)repo_dir}"
  print -r -- "caffeinate -i -t $(( hours * 3600 ))"
  print -r -- ${(q-)cmd}
  print -r -- "settings:"; print -r -- "$settings" | jq .
  exit 0
fi

cd "$repo_dir" || die "can't cd to $repo_dir"
"${cmd[@]}" || die "claude --bg failed"
setopt no_bg_nice
caffeinate -i -t $(( hours * 3600 )) &!
[[ -n ${TMUX:-} ]] && tmux display-message "autopilot: $name started; devlog: autopilot-$repo-devlog"
print -r -- "autopilot: $name started; the Mac stays awake for $hours h. Devlogs: http://localhost:9100/devlogs"
